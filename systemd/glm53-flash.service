# Autostart the pair at boot. Install:
#   sed -e "s|USER|$USER|g" -e "s|/opt/recipe|$PWD|g" systemd/glm53-flash.service | sudo tee /etc/systemd/system/glm53-flash.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now glm53-flash
# Other settings: a drop-in with Environment=CONTEXT=262144 or VISION=0 (systemctl edit glm53-flash).
[Unit]
Description=GLM-5.3-Flash EXL3 on two DGX Sparks (TensorFold native, TP=2)
After=network-online.target docker.service
Wants=network-online.target

[Service]
# oneshot + RemainAfterExit: `up` starts both ranks as detached containers and returns; `down` stops them.
Type=oneshot
RemainAfterExit=yes
User=USER
WorkingDirectory=/opt/recipe
Environment=HOME=/home/USER
Environment=PATH=/home/USER/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m spark up
ExecStop=/usr/bin/python3 -m spark down
Restart=on-failure
RestartSec=30
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
